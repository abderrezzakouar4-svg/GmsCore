{
  "problemMatcher": [
    {
      "owner": "gradle-build-kotlin-error-matcher",
      "severity": "error",
      "fileLocation": "absolute",
      "pattern": [
        {
          "regexp": "^e:\\s+(?:file://)?(.+?):(\\d+):(\\d+)\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}

